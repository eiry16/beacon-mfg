# 敏感信息（API Key 等）
.env
# .env 的备份同样含密钥（AMAP/ZHIPU/CF），必须一并挡住
.env.bak*

.env.local
.env.*.local
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/


# 内部维护脚本（不对外公开，仅本地维护使用）
# 注意：用 scripts/* 而不是 scripts/，否则下面两个白名单不生效
# （Git 不会进入已被整目录忽略的目录去匹配子文件）
scripts/*
# 例外：数据校验与统计脚本对外开放，CI 需要它们
!scripts/validate.py
!scripts/stats.py
# gb_store.py 是国标归档统一访问层（data/gb/ 的读写路径唯一来源），
# validate.py / stats.py 都依赖它，CI 必须能拿到，否则 data-validate 直接 ModuleNotFound。
# 它只有标准库依赖，不含密钥与商业逻辑。
!scripts/gb_store.py
# test_sharding.py 是 gb_store 分片逻辑的回归测试（临时目录跑，不碰真实数据）。
# 白名单理由同 gb_store：分片是归档写入路径的一部分，必须可回归。
!scripts/test_sharding.py
# 以下是客户 Agent 真正要跑的检索入口，SKILL.md 直接引用了它们。
# 不入库的后果：客户照着 SKILL.md 敲命令 → 文件不存在（2026-09-09 实测踩到）。
# 三者都是纯标准库（search_capabilities 依赖 gb_store，已放行），不含密钥与商业逻辑。
!scripts/query.py
!scripts/search_capabilities.py
!scripts/client_search.py
# deploy_pages.py 是 L1/L2 上 CDN 的唯一入口（封装 wrangler）。
# 不放行：别人 clone 后只能自己摸索 CF 的上传格式，而那个 API 是会静默成功的
# （2026-09-09 实测：三种写法全部返回 success，站点却全线 404）。
!scripts/deploy_pages.py
# gen_capability_shards.py 是 L1 能力卡国标分片的唯一生成器。
# 不放行的后果：客户照 SKILL.md 想按小类批量取能力卡 → 脚本不存在，
# 又退化成 4136 次单文件请求。纯标准库，只依赖 gb_store（已放行）。
!scripts/gen_capability_shards.py
# gen_manifest.py 生成 data/manifest.json（客户 Agent 增量拉取的清单指针）。
# 不放行：客户无法自建/校验清单，只能信任仓库里那份（2026-09-11 已在
# publish_registry.py 中调用它刷新 SHA1，白名单需配套）。
!scripts/gen_manifest.py
# publish_registry.py / endpoint_watch.py：注册发布与后端地址刷新入口
# （2026-09-11 放行 publish_registry，2026-09-12 补 endpoint_watch）。
!scripts/publish_registry.py
!scripts/endpoint_watch.py
# fetch_gaode_poi.py + fetch_batch.py + gui_app.py：采集与一键工具入口。
# 采集侧是数据生产路径，且 gui_app 依赖这两个模块；
# 不放行的后果：修好的采集脚本只存在于本地，换机器/换人就回到旧 bug。
!scripts/fetch_gaode_poi.py
!scripts/fetch_batch.py
!scripts/gui_app.py
# sync_gb_code.py 给 4136 张能力卡回写国标码，是 625 家品类冲突的解决方案入口。
# 不放行：别人没法复现冲突消解，也没法在名录国标变化后重新同步。纯标准库。
!scripts/sync_gb_code.py
# industry_taxonomy.py 是 query.py 的国标码表来源。不放行的话：
# query.py 走到 `except ImportError` 分支 → CODES={} → **任何 --industry 查询都返回
# "没匹配到任何国标行业"且不报错**（2026-09-09 实测）。纯标准库，仅读 data/gb4754-full.json。
!scripts/industry_taxonomy.py
# audit_alias.py 量的是「别名表到底让客户能搜到多少家」——覆盖率、供给覆盖率、
# 剩余缺口、采购词实测。客户和贡献者都要能自己复现这个结论，不能只有我说了算。
# 只依赖上面已放行的 gb_store / query，纯标准库。
!scripts/audit_alias.py
# publish_registry.py 是注册自动发布管线的唯一入口（刷新 manifest SHA1 + 提交 + push
# 检索云）。纯标准库，不含密钥与商业逻辑；CI 与换机复现都需要它。
!scripts/publish_registry.py
# gen_manifest.py 生成 data/manifest.json——那是 CDN 上对外发布的分片索引，
# 客户 Agent 与安卓端靠它做增量更新。生成器不入库 = 已发布产物无法复现
# （2026-09-09 给 manifest 加 t=phone 分片类型时暴露）。
# 纯标准库 + 已放行的 gb_store，不含密钥与商业逻辑。
!scripts/gen_manifest.py
# backfill_phone.py 是「待核实号码能不能补」的结论依据（高德 POI 反查 + 同名
# Jaccard ≥0.62 校验）。结论是命中率 2.5%、不建议全量跑——这个数字必须能被
# 别人自己复现，不能只有我说了算。纯标准库，只走公开 POI 接口，密钥读环境变量。
!scripts/backfill_phone.py
# sync_vendor_skills.py 是 L1 能力卡入口（registry/capability/{id}.json）的
# 唯一同步器，并把名录的 agent.skill_url 字段回写。脚本和 collect/render.py
# 互相依赖（前者 import 后者的 append_fingerprint），任一缺则 sync 流程不可
# 复现（2026-09-09 实测：脚本从不在白名单里、9-08 起的 sync 流程实际断链，
# 导致 registry/capability 只落地 4 家，635 家能力卡断在链路外）。两个一起放行。
!scripts/sync_vendor_skills.py
# collect/ 是 sync_vendor_skills 依赖的能力卡渲染子系统（render.py 在里面），
# 整个目录需要可重建——否则别人 clone 后跑 sync 会 ImportError（2026-09-09 实测）。
# fixtures 是测试夹具不进仓（CN-MFG-0000005.json 是个固定 fixture，与真实能力卡同 id 会被覆盖）。
!scripts/collect/
scripts/collect/fixtures/
# postfetch.py 是抓后派生层重建（classify/gbindex/fingerprint/shards/manifest/...
# 直至发布到 Pages）。fetch_batch 只落原始名录，**没有 postfetch 重建就是死数据**
# ——新供应商在所有检索里静默搜不到（2026-09-08 实测：cl 0 → 名录 23823 → 索引 0）。
# 纯标准库、无外部凭据，与 fetch_batch 互补。放行后 cron 跑得起来。
!scripts/postfetch.py
# CI 工作流对外开放（贡献者提 PR 时自动校验数据），其余 .github 内容不外发
.github/*
!.github/workflows/
.workbuddy/
examples/
docs/promotion/
docs/charts/
docs/backfill_unresolved.md
docs/audit_report.md
CRON_*.md
.env.example

# OS
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 私有层：不进 Git（2026-09-07 清理）
# Git 仓库只放引流层：薄名录 + L0 指纹 + 协议规范。
# 以下都是私有资产，一旦公开等于把商业逻辑送人。
# ---------------------------------------------------------------------------
# 注意：gitignore 不支持行尾注释，`path  # 说明` 会把整行当成一个 pattern，
# 规则静默失效。所有注释必须独占一行。
#
# 私有层 API（auth/api_key、routers/claim、services/ranker）
server/
# 例外：仅放开注册自动发布接线 collect.py（confirm 已接入 publish_registry）。
# server/ 是整目录忽略，必须按「放开目录 → server/** 重新忽略全部 → 再放开单文件」
# 顺序，否则 git 不会进入被忽略目录匹配子文件，且会连带暴露 auth/.data/logs/config 等私有资产。
!server/
server/**
!server/routers/
!server/routers/collect.py

# 采集脚本
run_fetch.ps1
# 校验脚本
run_validate.ps1
# 运行日志
fetch_log.txt
# 排名算法 + 认证设计（核心商业逻辑）
docs/API_RANKING_AUTH_DESIGN.md
# 内部修复记录
docs/fix_doc_number_drift_*.md

# ---------------------------------------------------------------------------
# 商业策略文档与原型（2026-09-08）
# 写明了护城河分析、定价策略、采集流程，公开等于把打法送人
# ---------------------------------------------------------------------------
docs/PROPOSAL_V2_COMMERCIAL.md
docs/PROPOSAL_VENDOR_SKILL.md
docs/PROPOSAL_A2A_OUTBOUND.md
docs/prototype/

# ---------------------------------------------------------------------------
# Skill 分层存储（2026-09-07 起）
#
# L0 指纹  skills/registry/fingerprint/*.jsonl  → 进 Git（客户 Agent 全量扫这层做初筛）
# L1 能力卡 skills/vendors/*/capability.json    → 不进 Git（走云端按需拉取）
# L2 自述   skills/vendors/*/SKILL.md           → 不进 Git（走云端按需拉取）
#
# 理由：1200+ 家 × (SKILL.md + capability.json) ≈ 11MB 且持续增长。
# 客户 Agent 只需 L0 指纹即可完成 95% 的初筛淘汰，命中后才调 API 取 L1/L2。
# 详见 docs/AUTO_PROFILE_REPORT.md
# ---------------------------------------------------------------------------
skills/vendors/*/SKILL.md
skills/vendors/*/capability.json
skills/vendors/*/assets/
skills/registry/capability/

# 重跑批量整理时归档的旧能力卡（reset_auto.py 生成，确认无误后可自行删除）
skills/_vendors_backup_*/
skills/_keep_sample/

# 例外：保留 1 家已认主样板进 Git，作为「标准长什么样」的参考
!skills/vendors/CN-MFG-0000005/SKILL.md
!skills/vendors/CN-MFG-0000005/capability.json

# 运行日志与临时文件
*.log
_fixed_*_backup.json
en_backfill_*
en_watchdog*
cjk_fix_*
# 列式导出产物（构建物，不进 Git）
dist/
# 部署打包的中间产物（deploy_pages.py 生成，200KB 压缩包，不进 Git）
pages/dist.zip

# ---------------------------------------------------------------------------
# 安卓客户端（APK/）
# 构建产物与本地配置不进 Git；内置 assets 由 tools/sync_assets.py 从仓库数据
# 重新生成，避免 4.76MB 指纹在仓库里存两份（原始来源 skills/registry/fingerprint 已入库）
# ---------------------------------------------------------------------------
APK/.gradle/
APK/build/
APK/app/build/
APK/local.properties
APK/app/src/main/assets/
# 构建产物：19MB 的 apk 不进仓库（要装机的包走本地构建，见 APK/build.sh）
APK/*.apk
APK/app/src/androidTest/assets/e2e_expect.json
