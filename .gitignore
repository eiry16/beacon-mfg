# ---------------------------------------------------------------------------
# 本仓库定位：MCP 分发入口
#   入库 = 运行 MCP 必需的代码 + 许可声明 + 用户接入说明
#   数据面（data/、skills/registry/）由 https://beacon-mfg.pages.dev 提供，不入库
#   设计文档、采集流水线、App/控制台源码一律留在本地，不入库
# ---------------------------------------------------------------------------

# 数据面（运行时从远端拉，仓库只做分发）
data/
skills/registry/
skills/vendors/
cache/

# 非分发面源码与文档
scripts/
server/
pages/
APK/
docs/
agent-skill/
schema/
templates/
skills/profiles/
skills/_vendors_backup_*/
# npm prepack 时把 skills/rfq-kernel 拷进 mcp/rfq-kernel，属派生副本
mcp/rfq-kernel/

# 敏感信息
.env
.env.*
secrets/
*.pem
*.p12

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# CI：只保留两个发布 workflow
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/mcp-release.yml
!.github/workflows/npm-publish.yml

# 本地运维与内部文件
SKILLHUB_SUBMISSION.md
项目调试说明.md
cron_manager.*
start_cron_manager.bat
examples/
skills/README.md
skills/TEMPLATE.md
mcp/test_*.py
mcp/test_update.js

# 本地产物与临时文件
*.log
*.apk
*.lnk
dist/
.wrangler/
_backup/
_archive/
.workbuddy/

# OS
.DS_Store
Thumbs.db
