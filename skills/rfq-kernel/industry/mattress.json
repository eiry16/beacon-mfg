  "dfm_rules": [
    {
      "id": "MT-R01",
      "when": { "field": "thickness_cm", "op": "gt", "value": 30 },
      "requires": {},
      "result": "needs_human",
      "reason_code": "CAP.OVERSIZE",
      "message": "厚度 >30cm 需确认压缩卷包设备与物流体积限制"
    },
    {
      "id": "MT-R02",
      "when": { "field": "foam_density_kgm3", "op": "lt", "value": 20 },
      "requires": {},
      "result": "needs_human",
      "reason_code": "CAP.TOLERANCE",
      "message": "密度 <20kg/m3 长期使用塌陷风险高，需与客户确认使用场景"
    }
  ],

  "negative_capability_hints": [
    "不做乳胶",
    "不做记忆棉",
    "不做婴幼儿床垫",
    "不做出口英国 BS5852"
