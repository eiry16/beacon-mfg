{
  "$comment": "F 门类（批发和零售业）能力卡 schema 片段。与 gates/C.json、gates/H.json、gates/R.json 完全独立。F 与 O 共用 retail-service 码表域，但**私有块各写各的**：F 问「卖什么货、怎么发货」，O 问「做什么服务、上不上门」—— 共用码表的只是那几组真的同构的字段（经营方式/交付方式/门店设施）。",
  "gate": "F",
  "gate_name": "批发和零售业",
  "gate_range": "51 批发业 / 52 零售业",
  "id_prefix": "F",
  "id_prefix_note": "新门类用 CN-F-{7位序号}。制造业的 CN-MFG- 是历史前缀，不迁移。",
  "cap_domain": "retail-service",
  "default_profile": "retail-shop",
  "profile_by_category": {
    "零售门店": "retail-shop",
    "批发商行": "retail-shop",
    "批零兼营": "retail-shop",
    "专营专卖": "retail-shop",
    "综合超市": "retail-shop",
    "网店电商": "retail-shop",
    "市场摊位": "retail-shop",
    "其他零售": "retail-shop"
  },
  "caps_index_from": [
    "capability.retail_categories[]",
    "capability.business_modes[]",
    "capability.delivery_modes[]",
    "capability.store_features[]",
    "quality.certifications[].name",
    "category"
  ],
  "poi_types": {
    "$comment": "高德 POI type → GB/T 4754 小类码。**最长前缀命中者赢**（gate_schema.poi_to_gb）：`ambiguous` 与 `prefix` 两张表一起比长度，更具体的规则胜出。",
    "prefix": {
