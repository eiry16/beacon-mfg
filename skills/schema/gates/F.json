  "schema_extra": {
    "required": [
      "limits",
      "capability"
    ],
    "properties": {
      "category": {
        "type": "string",
        "enum": [
          "零售门店",
          "批发商行",
          "批零兼营",
          "专营专卖",
          "综合超市",
          "网店电商",
          "市场摊位",
          "其他零售"
        ],
        "description": "经营形态展示标签。**卖什么货不在这里** —— 那是 capability.retail_categories，一个店可以同时卖很多品类。"
      },
      "limits": {
        "type": "object",
        "description": "交易硬边界。采购方的一票否决项主要落在这几个数上",
        "additionalProperties": false,
        "properties": {
          "min_order_qty": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "最少起订量（件/箱/吨，单位见 capability.purchase_unit）"
          },
          "min_order_value_cny": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "起批金额（元）"
          },
          "stock_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否有现货。没现货就变成订货，交期完全不同"
          },
          "delivery_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "常规发货/到货天数"
          },
          "delivery_radius_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "同城配送半径（公里）。超出就转快递或物流"
          },
          "max_daily_orders": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "日最大接单量"
          },
          "current_load_pct": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "当前忙碌度/备货压力"
          },
          "rush_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "能否加急发货"
          }
        }
      },
      "capability": {
        "type": "object",
        "description": "零售能力块。字段由本文件与 skills/profiles/retail-shop.json 共同定义。",
        "additionalProperties": false,
        "properties": {
          "retail_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:零售品类"
            },
            "description": "经营品类码列表。枚举由 cap-codes/retail-service.json 的「零售品类」组运行时注入"
          },
          "business_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:经营方式"
            },
            "description": "经营方式码（门店零售/批发/网店/直播带货…）"
          },
          "delivery_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:交付方式"
            },
            "description": "交付方式码（自提/同城配送/快递/物流托运…）"
          },
          "store_features": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:门店设施"
            },
            "description": "门店设施码（冷库/仓储/可开票…）"
          },
          "sku_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "在售 SKU 数量。判断是杂货铺还是批发商的粗粒度信号"
          },
          "brands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "主营品牌 / 代理品牌"
          },
          "purchase_unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "起订单位原文，如「件」「箱」「吨」「米」。保留原话 —— 换算成统一单位会假设错"
          },
          "business_hours": {
            "type": [
              "string",
              "null"
            ],
            "description": "营业时间原文"
          }
        }
      },
      "service": {
        "type": "object",
        "description": "交易与结算服务",
        "additionalProperties": false,
        "properties": {
          "quote_inputs_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "询价需提供什么，如 品名、规格、数量、收货地"
          },
          "quote_response_hours": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "报价响应时效（小时）"
          },
          "wholesale_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否接批发"
          },
          "invoice_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "能否开票。企业采购入账的硬条件"
          },
          "return_policy": {
            "type": [
              "string",
              "null"
            ],
            "description": "退换货政策原文"
          },
          "payment_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "quality": {
        "type": "object",
        "description": "经营资质与货源可信度",
        "additionalProperties": false,
        "properties": {
          "certifications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valid_until": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "enum": [
                    "self_declared",
                    "public_record",
                    "platform_verified",
                    "field_audited"
                  ]
                }
              }
            },
            "description": "食品经营许可证 / 烟草专卖零售许可证 / 药品经营许可证 / 酒类流通备案 等"
          },
          "brand_authorized": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否为品牌授权经销。采购方判断货源正规性的关键信号"
          },
          "source_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "货源说明原文，如「厂家直供」「一级代理」「市场拿货」"
          }
        }
      }
    }
  }
}
