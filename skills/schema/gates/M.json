  "schema_extra": {
    "required": [
      "limits",
      "capability"
    ],
    "properties": {
      "category": {
        "type": "string",
        "enum": [
          "检验检测",
          "计量校准",
          "认证认可",
          "环境监测",
          "测绘地理信息",
          "工程勘察设计",
          "工程监理",
          "工业设计",
          "技术研发",
          "生物医药研发",
          "新材料研发",
          "节能环保",
          "知识产权服务",
          "科技中介",
          "其他技术服务"
        ],
        "description": "业态展示标签。**具体能做什么不在这里** —— 那是 capability.tech_directions，一家检测机构常同时具备多个资质范围。"
      },
      "limits": {
        "type": "object",
        "description": "委托硬边界。甲方立项时的一票否决项主要落在这几个数上",
        "additionalProperties": false,
        "properties": {
          "min_order_qty": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "最少起做量（样本数/件数）。小于这个量不接"
          },
          "min_order_value_cny": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "最低委托金额（元）"
          },
          "report_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "常规出报告天数。检测/校准类最关键的硬指标"
          },
          "response_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "响应时效（小时）。含现场采样类服务的到场时效"
          },
          "max_concurrent_projects": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "同时在制项目数上限"
          },
          "current_load_pct": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "当前排期负荷。实验室与工程师时间是主要瓶颈"
          },
          "rush_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "能否加急出报告"
          }
        }
      },
      "capability": {
        "type": "object",
        "description": "科研技术能力块。字段由本文件与 skills/profiles/tech-research.json 共同定义。",
        "additionalProperties": false,
        "properties": {
          "tech_directions": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "tech-service:科研技术方向"
            },
            "description": "技术方向码列表。枚举由 cap-codes/tech-service.json 的「科研技术方向」组运行时注入"
          },
          "service_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "tech-service:服务模式"
            },
            "description": "服务模式码（委托检测/驻场服务/联合研发/技术转移…）"
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "tech-service:交付成果"
            },
            "description": "交付成果码（检测报告/校准证书/设计图纸/专利软著…）"
          },
          "team_roles": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "tech-service:团队构成"
            },
            "description": "团队构成码。有没有研究员/检测工程师，决定能接研发还是只能接常规检测"
          },
          "team_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "团队人数"
          },
          "researcher_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "研发/技术人员数。0 是有效答案（全员非技术），不等于未填"
          },
          "key_instruments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "关键仪器设备，如 三坐标测量机、光谱仪、环境试验箱。**能不能做这项检测就看有没有这台机器**，是比资质更硬的能力证据"
          },
          "portfolio": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "代表案例原文。写具体项目与委托方类型，不要写形容词"
          },
          "support_hours": {
            "type": [
              "string",
              "null"
            ],
            "description": "服务时段原文，如「工作日 9:00-17:30」「采样 7×24 接单」"
          }
        }
      },
      "service": {
        "type": "object",
        "description": "委托与结算",
        "additionalProperties": false,
        "properties": {
          "quote_inputs_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "报价需提供什么，如 样品、检测项目、执行标准、报告用途"
          },
          "quote_response_hours": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "报价响应时效（小时）"
          },
          "payment_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "invoice_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "能否开票"
          },
          "nda_accepted": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否接受保密协议。研发外包与专利服务的前置条件"
          },
          "sample_return": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "样品是否退还。破坏性检测不能退，甲方要提前知道"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "报告语言 / 对接语言"
          }
        }
      },
      "quality": {
        "type": "object",
        "description": "资质与认可。**这一块是 M 门类的信任核心**：检测报告能不能被采信，全看下面三个字段",
        "additionalProperties": false,
        "properties": {
          "cma_accredited": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否具备 CMA（检验检测机构资质认定）。**没有 CMA 出的报告不能用于司法/行政/社会公证**，这是甲方第一道筛选"
          },
          "cnas_accredited": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否具备 CNAS（实验室认可）。国际互认，出口相关检测的硬门槛"
          },
          "certifications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valid_until": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "enum": [
                    "self_declared",
                    "public_record",
                    "platform_verified",
                    "field_audited"
                  ]
                }
              }
            },
            "description": "CMA 证书 / CNAS 认可证书 / ISO17025 / 高新技术企业 / 工程勘察设计资质 / 工程设计资质 等"
          }
        }
      }
    }
  }
}
