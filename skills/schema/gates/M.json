{
  "$comment": "M 门类（科学研究和技术服务业）能力卡 schema 片段。与 gates/I.json 共用 tech-service 码表域，但私有块故意不同：M 有 cma_accredited / cnas_accredited / key_instruments / researcher_count（检测机构与研究院所的核心资质与资产），I 有 tech_stacks / open_source。共用码表的只是那几组真的同构的字段。",
  "gate": "M",
  "gate_name": "科学研究和技术服务业",
  "gate_range": "73 研究和试验发展 / 74 专业技术服务业 / 75 科技推广和应用服务业",
  "id_prefix": "M",
  "id_prefix_note": "新门类用 CN-M-{7位序号}。制造业的 CN-MFG- 是历史前缀，不迁移。**注意别混淆**：CN-MFG- 里的 MFG 是历史前缀，M 是门类字母，两者共存且语义不同，判定一律走 cap_codes.gate_of_id。",
  "cap_domain": "tech-service",
  "default_profile": "tech-research",
  "profile_by_category": {
    "检验检测": "tech-research",
    "计量校准": "tech-research",
    "认证认可": "tech-research",
    "环境监测": "tech-research",
    "测绘地理信息": "tech-research",
    "工程勘察设计": "tech-research",
    "工程监理": "tech-research",
    "工业设计": "tech-research",
    "技术研发": "tech-research",
    "生物医药研发": "tech-research",
    "新材料研发": "tech-research",
    "节能环保": "tech-research",
    "知识产权服务": "tech-research",
    "科技中介": "tech-research",
    "其他技术服务": "tech-research"
  },
  "caps_index_from": [
    "capability.tech_directions[]",
    "capability.service_modes[]",
    "capability.deliverables[]",
    "capability.team_roles[]",
    "quality.certifications[].name",
    "quality.cma_accredited:CMA",
    "quality.cnas_accredited:CNAS",
    "category"
  ],
  "poi_types": {
