{
  "$comment": "C 门类（制造业）能力卡 schema 片段。业务字段从 skills/schema/vendor-skill.schema.json 原样搬来，**未做任何语义改动** —— 迁移的硬要求是：C 门类合并后的成品 schema 与旧 schema 对既有样本的判定逐条一致（见 scripts/test_gate_expansion.py）。",
  "gate": "C",
  "gate_name": "制造业",
  "gate_range": "13-43 大类",
  "id_prefix": "MFG",
  "id_prefix_note": "制造业沿用历史前缀 CN-MFG-。名录已发 23823 条，不迁移；新发也沿用，避免打断认领/认证档案号（CERT-YYYYMMDD-NNNN）的追溯链。",
  "cap_domain": "manufacturing",
  "cap_domain_note": "工艺域。码表落在 skills/schema/process-codes.json（既有文件，零迁移），由 cap-codes/_registry.json 正式登记为 manufacturing 域。",
  "default_profile": "custom",
  "profile_by_category": {
    "精密机械加工": "precision-machining",
    "钣金冲压": "sheet-metal",
    "注塑成型": "injection-molding",
    "压铸": "die-casting",
    "电子元器件": "electronics",
    "表面处理": "surface-treatment",
    "标准件": "standard-parts",
    "原材料": "raw-materials"
  },
  "caps_index_from": [
    "processes[].code",
    "materials[]",
    "quality.certifications[].name"
  ],

  "schema_extra": {
    "required": ["processes", "limits"],

    "properties": {
      "category": {
        "type": "string",
        "enum": [
          "精密机械加工",
          "钣金冲压",
          "注塑成型",
          "压铸",
          "电子元器件",
          "表面处理",
          "标准件",
          "原材料",
          "其他"
        ]
      },

      "processes": {
        "type": "array",
        "minItems": 1,
        "description": "工艺能力。code 须存在于 manufacturing 域码表（skills/schema/process-codes.json）。",
        "items": {
          "type": "object",
          "required": ["code", "name"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
            "name": { "type": "string" },
            "level": {
              "type": "string",
              "enum": ["primary", "secondary", "outsourced", "planning"]
            }
          }
        }
      },

      "process_self_report": {
        "type": "object",
        "description": "工艺的企业原话溯源。码表有对应码时必须落 processes；本字段只留原话与说明，不得当作工艺位的替代品。",
        "additionalProperties": false,
        "properties": {
          "quote": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      },

      "limits": {
        "type": "object",
        "description": "硬边界。客户 Agent 淘汰供应商的主要依据，禁止虚报",
        "additionalProperties": false,
        "properties": {
          "min_order_qty": { "type": ["integer", "null"], "minimum": 1 },
          "min_order_value_cny": { "type": ["number", "null"], "minimum": 0 },
          "max_part_size_mm": {
            "type": ["array", "null"],
            "minItems": 2,
            "maxItems": 3,
            "items": { "type": "number", "minimum": 0 }
          },
          "min_feature_size_mm": { "type": ["number", "null"], "minimum": 0 },
          "tolerance_mm": { "type": ["number", "null"], "minimum": 0 },
          "surface_finish_ra": { "type": ["number", "null"], "minimum": 0 },
          "monthly_capacity": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "number" },
              "unit": { "type": "string" }
            }
          },
          "current_load_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
          "rush_available": { "type": ["boolean", "null"] },
          "lead_time_days": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "sample": { "type": ["integer", "null"], "minimum": 0 },
              "batch_100": { "type": ["integer", "null"], "minimum": 0 },
              "batch_1000": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        }
      },

      "materials": {
        "type": "array",
        "items": { "type": "string" }
      },

      "highlights": {
        "type": "array",
        "description": "供应商擅长场景。渲染进 SKILL.md 的「我们特别擅长」段",
        "items": { "type": "string" }
      },

      "quality": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "certifications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "number": { "type": ["string", "null"] },
                "valid_until": { "type": ["string", "null"] },
                "evidence": {
                  "type": "string",
                  "enum": ["self_declared", "public_record", "platform_verified", "field_audited"]
                }
              }
            }
          },
          "inspection_equipment": { "type": "array", "items": { "type": "string" } },
          "first_article_report": { "type": ["boolean", "null"] },
          "material_certificate": { "type": ["boolean", "null"] },
          "rohs_reach": { "type": ["boolean", "null"] },
          "ppap_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
          "traceability": { "type": ["boolean", "null"] }
        }
      },

      "service": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "quote_response_hours": { "type": ["integer", "null"], "minimum": 1 },
          "quote_inputs_required": { "type": "array", "items": { "type": "string" } },
          "accepted_drawing_formats": { "type": "array", "items": { "type": "string" } },
          "nda_accepted": { "type": ["boolean", "null"] },
          "sample_policy": { "type": ["string", "null"] },
          "payment_terms": { "type": "array", "items": { "type": "string" } },
          "trade_terms": { "type": "array", "items": { "type": "string" } },
          "shipping": { "type": "array", "items": { "type": "string" } },
          "languages": { "type": "array", "items": { "type": "string" } },
          "working_hours": { "type": ["string", "null"] },
          "installation": {
            "type": ["boolean", "null"],
            "description": "是否含现场安装调试。成套设备（equipment_assembly）询单必问项，认证采集中缺失率最高的一项"
          }
        }
      }
    }
  }
}
