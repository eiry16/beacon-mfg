{
  "$comment": "O 门类（居民服务、修理和其他服务业）能力卡 schema 片段。与 gates/F.json 共用 retail-service 码表域，但私有块**故意不同**：O 没有 retail_categories / sku_count / brands（个体服务户不备货、不做品牌代理），多出 technician_count / service_radius_km / warranty_days —— 修车和家政的筛选条件与卖货完全是两回事。",
  "gate": "O",
  "gate_name": "居民服务、修理和其他服务业",
  "gate_range": "80 居民服务业 / 81 机动车、电子产品和日用产品修理业 / 82 其他服务业",
  "id_prefix": "O",
  "id_prefix_note": "新门类用 CN-O-{7位序号}。制造业的 CN-MFG- 是历史前缀，不迁移。",
  "cap_domain": "retail-service",
  "default_profile": "resident-service",
  "profile_by_category": {
    "家政服务": "resident-service",
    "洗衣洗染": "resident-service",
    "美容美发": "resident-service",
    "洗浴养生": "resident-service",
    "摄影婚庆": "resident-service",
    "汽车维修": "resident-service",
    "家电数码维修": "resident-service",
    "水电开锁疏通": "resident-service",
    "清洁搬家": "resident-service",
    "宠物服务": "resident-service",
    "托育照护": "resident-service",
    "其他服务": "resident-service"
  },
  "caps_index_from": [
    "capability.service_items[]",
    "capability.business_modes[]",
    "capability.delivery_modes[]",
    "capability.store_features[]",
    "quality.certifications[].name",
    "category"
  ],
  "poi_types": {
