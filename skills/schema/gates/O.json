  "schema_extra": {
    "required": [
      "limits",
      "capability"
    ],
    "properties": {
      "category": {
        "type": "string",
        "enum": [
          "家政服务",
          "洗衣洗染",
          "美容美发",
          "洗浴养生",
          "摄影婚庆",
          "汽车维修",
          "家电数码维修",
          "水电开锁疏通",
          "清洁搬家",
          "宠物服务",
          "托育照护",
          "其他服务"
        ],
        "description": "服务业态展示标签。**具体会干什么不在这里** —— 那是 capability.service_items，一个师傅可以同时修家电和装空调。"
      },
      "limits": {
        "type": "object",
        "description": "服务硬边界。客户找服务时的一票否决项主要落在这几个数上",
        "additionalProperties": false,
        "properties": {
          "min_order_qty": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "最少起接量（单/台/次）"
          },
          "min_order_value_cny": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "起步价（元）。0 是有效答案（不收上门费）"
          },
          "response_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "上门/响应时长（小时）。急修场景的硬指标"
          },
          "service_radius_km": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "服务半径（公里）。超范围就不接或加价，是第一个要看的数"
          },
          "max_daily_orders": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "日最大接单量"
          },
          "advance_booking_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "需提前几天预约"
          },
          "current_load_pct": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "当前接单饱和度"
          },
          "rush_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "能否加急上门"
          }
        }
      },
      "capability": {
        "type": "object",
        "description": "居民服务能力块。字段由本文件与 skills/profiles/resident-service.json 共同定义。",
        "additionalProperties": false,
        "properties": {
          "service_items": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:服务项目"
            },
            "description": "服务项目码列表。枚举由 cap-codes/retail-service.json 的「服务项目」组运行时注入"
          },
          "business_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:经营方式"
            },
            "description": "经营方式码（门店服务/上门服务/连锁加盟…）"
          },
          "delivery_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:交付方式"
            },
            "description": "服务交付方式码（上门施工/取送件/寄修…）"
          },
          "store_features": {
            "type": "array",
            "items": {
              "type": "string",
              "x-enum-from": "retail-service:门店设施"
            },
            "description": "门店设施码（停车位/可开票/夜间营业…）"
          },
          "technician_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "师傅/技工人数。决定能不能同时接多单，是产能口径（老板自己干就是 1）"
          },
          "service_guarantee": {
            "type": [
              "string",
              "null"
            ],
            "description": "服务保障原文，如「不满意返工」「原厂配件」"
          },
          "business_hours": {
            "type": [
              "string",
              "null"
            ],
            "description": "营业/接单时间原文"
          }
        }
      },
      "service": {
        "type": "object",
        "description": "接单与结算服务",
        "additionalProperties": false,
        "properties": {
          "booking_channels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "接单渠道，如 电话 / 微信 / 美团 / 58同城"
          },
          "quote_inputs_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "报价需提供什么，如 照片、品牌型号、地址"
          },
          "quote_response_hours": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "description": "报价响应时效（小时）"
          },
          "warranty_days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "质保天数。0 是有效答案（不质保），不等于未填"
          },
          "price_list_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否有标准价目表。有价目表的更好比价"
          },
          "invoice_available": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "能否开票"
          },
          "payment_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "quality": {
        "type": "object",
        "description": "经营资质与人员资格",
        "additionalProperties": false,
        "properties": {
          "certifications": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "number": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "valid_until": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "enum": [
                    "self_declared",
                    "public_record",
                    "platform_verified",
                    "field_audited"
                  ]
                }
              }
            },
            "description": "机动车维修经营备案 / 特种设备安装改造维修许可证 / 再生资源回收经营者备案 等"
          },
          "technician_certified": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "师傅是否持职业资格证/上岗证。家政、月嫂、维修的信任锚点"
          },
          "hygiene_grade": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "A",
              "B",
              "C",
              "未评定",
              null
            ],
            "description": "公共场所卫生监督量化分级。理发美容、洗浴适用"
          }
        }
      }
    }
  }
}
